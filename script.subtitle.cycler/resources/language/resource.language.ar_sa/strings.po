# Kodi Media Center language file
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ar_SA\n"

msgctxt "#32000"
msgid "General"
msgstr "عام"

msgctxt "#32001"
msgid "Close gaps between subtitle lines"
msgstr "سد الفواصل بين سطور الترجمة"

msgctxt "#32002"
msgid "Close gaps up to (ms)"
msgstr "سد الفواصل حتى (ملي ثانية)"

msgctxt "#32003"
msgid "Keep line longer on long gaps (ms)"
msgstr "إبقاء السطر أطول في الفواصل الطويلة (ملي ثانية)"

msgctxt "#32004"
msgid "Applies to every external SRT subtitle, however it was loaded."
msgstr "يُطبّق على أي ترجمة SRT خارجية، بأي طريقة تحمّلت."

msgctxt "#32005"
msgid "Gaps up to this length are closed: the line stays until the next one starts."
msgstr "الفواصل الأقصر من هذا تنسد: يبقى السطر لين يجي اللي بعده."

msgctxt "#32006"
msgid "For longer gaps the line stays this much longer. 0 = off."
msgstr "في الفواصل الأطول يبقى السطر هذي المدة الإضافية. 0 = إيقاف."


msgctxt "#32007"
msgid "Sync timing to the video's embedded subtitles"
msgstr "مزامنة التوقيت مع الترجمة المدمجة في الفيديو"

msgctxt "#32008"
msgid "For MKV videos with a text subtitle track (any language): shift external SRT subtitles so their timing matches it. Reads only a small part of the video."
msgstr "لملفات MKV التي فيها ترجمة نصية مدمجة (بأي لغة): يضبط توقيت ترجمات SRT الخارجية ليتطابق معها. يقرأ جزءاً صغيراً فقط من الفيديو."

msgctxt "#32009"
msgid "Anime from Otaku"
msgstr "الأنمي من Otaku"

msgctxt "#32010"
msgid "Find subtitles for anime played from Otaku"
msgstr "البحث عن ترجمات للأنمي المشغّل من Otaku"

msgctxt "#32011"
msgid "Otaku gives Kodi no IMDb id, so a4kSubtitles cannot search. With this on, the button looks the ids up in Otaku's own database and searches a4kSubtitles with them."
msgstr "إضافة Otaku لا تعطي كودي رقم IMDb، فلا يستطيع a4kSubtitles البحث. عند التفعيل يأخذ الزر الأرقام من قاعدة بيانات Otaku ويبحث بها في a4kSubtitles."

msgctxt "#32012"
msgid "Load a subtitle automatically when an Otaku episode starts"
msgstr "تحميل ترجمة تلقائياً عند بدء حلقة من Otaku"

msgctxt "#32013"
msgid "About 15 seconds after an Otaku episode starts, the first subtitle that fits the video is loaded."
msgstr "بعد نحو 15 ثانية من بدء الحلقة تُحمَّل أول ترجمة تناسب الفيديو."
